generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  phone      String?
  password   String
  role       String   @default("BUYER") // BUYER, VENDOR, ADMIN
  status     String   @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  banReason  String?
  xp         Int      @default(0)
  badgesJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendorProfile VendorProfile?
  designs       Design[]
  quotesSent    QuoteRequest[]  @relation("BuyerQuotes")
  auditLogs     AdminAuditLog[] @relation("AuditActor")
}

model VendorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  contactEmail    String
  phone           String?
  city            String
  gstin           String?
  kycDocUrl       String?
  approvalStatus  String   @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  approvalNotes   String?
  leadDays        Int      @default(14)
  warrantyYears   Int      @default(5)
  rating          Float    @default(4.5)
  isSponsored     Boolean  @default(false)
  sponsoredBidAmt Float    @default(0.0)
  adStatus        String   @default("PAUSED") // ACTIVE, PAUSED, CAPPED
  adHeadline      String?
  adDailyCap      Float    @default(500.0)
  adSpentMonth    Float    @default(0.0)
  adImpressions   Int      @default(0)
  adClicks        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rateCards      VendorRateCard[]
  quotesReceived QuoteRequest[]   @relation("VendorQuotes")
}

model MasterElement {
  id              String   @id @default(cuid())
  category        String   // CABIN, DOOR, WINDOW, EQUIPMENT, STAIRS, POD
  subCategory     String?  // HVAC, SOLAR, PLUMBING, ACCESS, INTERIOR, LIGHTING, SECURITY
  code            String   @unique
  name            String
  friendlyName    String?
  description     String?
  mountZone       String?  // WALL_EXTERIOR, WALL_INTERIOR, ROOF_TOP, FLOOR_INTERIOR, PERIMETER_EDGE
  dimensionsJson  String   // { width, height, length, depth, weightKg }
  baseCost        Float    @default(0)
  optionsJson     String   @default("{}") // { spotLabel, brands[], capacities[], finishes[] }
  threeConfigJson String?  // { renderer, primitives: [...] }
  iconUrl         String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MasterAttribute {
  id           String   @id @default(cuid())
  category     String   // GLASS_TYPE, FRAME_MATERIAL, BRAND, WALL_FINISH, SOLAR_CAPACITY, INSULATION
  code         String   @unique
  name         String
  friendlyName String?
  brand        String?
  specsJson    String?
  shaderJson   String   // Three.js PBR shader values
  costModifier Float    @default(0)
  iconUrl      String?
  textureUrl   String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VendorRateCard {
  id                     String   @id @default(cuid())
  vendorId               String
  elementCode            String
  baseUnitPrice          Float
  attributeModifiersJson String   @default("{}")
  leadTimeDays           Int      @default(14)
  warrantyNotes          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, elementCode])
}

model RoomPreset {
  id               String   @id @default(cuid())
  code             String   @unique
  title            String
  subtitle         String
  sizeLabel        String
  approxPriceLabel String
  badge            String?
  iconName         String?
  thumbUrl         String?
  environment      String   @default("forest")
  targetBudget     Float    @default(380000)
  sceneJson        String   // { cabins: [], equipment: [] }
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DesignChallenge {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String
  badgeName    String
  badgeIcon    String   @default("🏆")
  badgeIconUrl String?
  rewardXp     Int      @default(300)
  rulesJson    String   // Array of declarative ChallengeRule objects
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LogisticsDefaults {
  id                     String   @id @default("singleton")
  gstRatePct             Float    @default(18)
  transportPerKm20ft     Float    @default(85)
  transportPerKm40ft     Float    @default(115)
  craneGroundFee         Float    @default(6500)
  craneTerraceFee        Float    @default(18500)
  knockDownPerKm         Float    @default(45)
  knockDownAssemblyFee   Float    @default(18000)
  foundationGroundFee    Float    @default(6500)
  foundationUpperFee     Float    @default(12000)
  puf50mmCost            Float    @default(14000)
  flyRoofCanopyPrice     Float    @default(24000)
  defaultRefurbDiscount  Float    @default(38)
  defaultUsedWwtDiscount Float    @default(55)
  minBidAmount           Float    @default(10)
  maxBidAmount           Float    @default(500)
  updatedAt              DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  diffJson   String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model Design {
  id             String          @id @default(cuid())
  userId         String
  title          String
  slug           String          @unique
  description    String?
  isPublic       Boolean         @default(false)
  previewImage   String?
  viewCount      Int             @default(0)
  shareCount     Int             @default(0)
  remixCount     Int             @default(0)
  parentDesignId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions DesignVersion[]
  quotes   QuoteRequest[]
}

model DesignVersion {
  id            String   @id @default(cuid())
  designId      String
  versionNumber Int      @default(1)
  commitNote    String   @default("Initial layout")
  sceneJson     String
  bomJson       String
  snapshotUrl   String?
  createdAt     DateTime @default(now())

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id              String        @id @default(cuid())
  designId        String
  buyerId         String
  vendorId        String
  status          String        @default("PENDING") // PENDING, NEGOTIATING, ACCEPTED, REJECTED
  negotiatedTotal Float
  messagesJson    String        @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  design Design        @relation(fields: [designId], references: [id], onDelete: Cascade)
  buyer  User          @relation("BuyerQuotes", fields: [buyerId], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation("VendorQuotes", fields: [vendorId], references: [id], onDelete: Cascade)
}
